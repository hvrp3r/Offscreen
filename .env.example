# Copy this file to .env at the repository root to override settings in development.
# Variables already set in the environment take precedence over this file.
# API keys entered in the application are stored in the system secret store, never in this file.

# Port of the core HTTP and WebSocket API.
OFFSCREEN_SERVER__PORT=8420

# Minimum log level: Trace, Debug, Information, Warning, Error or Critical.
OFFSCREEN_LOGGING__LOGLEVEL__DEFAULT=Information
